DirectoryIndex index.php
Options -Indexes

# Keep leads and config private
RedirectMatch 403 ^.*/(data|includes)/

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression (never for contact.php / mail-test.php: compression buffers the
# response, which would make the visitor wait for the emails to be sent)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI "(contact|mail-test)\.php$" no-gzip=1 dont-vary=1
</IfModule>

# Browser caching for static assets (bust with ?v= in index.php)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
